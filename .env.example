# ---- Database ---------------------------------------------------------------------
# Local development uses an embedded PostgreSQL started by `npm run db:start`.
DATABASE_URL="postgresql://theprivate:theprivate@127.0.0.1:54329/theprivate"

# ---- Auth -------------------------------------------------------------------------
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---- Integrations (leave empty until credentials and approvals exist) ---------------
EMAIL_PROVIDER=""          # resend | postmark | ses
EMAIL_API_KEY=""
EMAIL_FROM=""
SMS_PROVIDER=""            # twilio | gupshup
SMS_API_KEY=""
WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""
PAYMENTS_MODE="pre-payment" # pre-payment | razorpay | stripe  (no real transactions in pre-payment mode)
STORAGE_DRIVER="local"      # local | s3
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
SENTRY_DSN=""
LOG_LEVEL="info"

# ---- Public URL used in e-mails and links ---------------------------------------------------
PUBLIC_APP_URL="https://theprivate.in"

# ---- SMTP (server-side only; never NEXT_PUBLIC_*) -------------------------------------------
# Gmail: SMTP_HOST is inferred as smtp.gmail.com for @gmail.com users; use an App Password.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""            # or SMTP_APP_PASSWORD (spaces are ignored)
SMTP_FROM_NAME="ThePrivate"
SMTP_FROM_EMAIL=""          # defaults to SMTP_USER
SMTP_REPLY_TO=""
# SMTP_TRANSPORT="capture"  # tests/dry runs only: no network, nothing delivered

# ---- Company invitations (see docs/INVITATION_CAMPAIGN_GUIDE.md) ----------------------------
LIVE_SEND_ENABLED="false"    # real companies are e-mailed ONLY when this is exactly "true"
SENDER_POSTAL_ADDRESS=""     # required before live sending (sender identification)
INVITE_EXPIRY_DAYS="0"           # 0 = invitation links never expire (default)
INVITE_SEND_INTERVAL_SECONDS="45"
INVITE_DAILY_CAP="80"
INVITE_TEST_ALLOWLIST=""     # extra addresses allowed to receive TEST e-mails (comma-separated)
UNSUBSCRIBE_SECRET=""        # defaults to BETTER_AUTH_SECRET
CRON_SECRET=""               # enables GET /api/cron/worker (Bearer token) on hosts without a worker

# ---- Company onboarding fee (see docs/ONBOARDING_PAYMENT_CONFIGURATION.md) ------------------
ONBOARDING_PAYMENT_PROVIDER=""   # "razorpay" in production; "sandbox" is refused in production builds
ONBOARDING_PAYMENTS_LIVE="false" # real-money collection (live keys) requires explicit approval
# Razorpay Standard Checkout. Server-only: never prefix with NEXT_PUBLIC_ (the key id reaches the
# browser only as a prop of the checkout page). rzp_test_ keys are refused when VERCEL_ENV=production.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""      # optional backup channel (events: order.paid, refund.processed)

# ---- Accounts ---------------------------------------------------------------------------------
AUTH_REQUIRE_EMAIL_VERIFICATION=""  # verification is on in production when SMTP works; "false" turns it off
IMPORT_TX_TIMEOUT_MINUTES=""        # data import transaction limit (default 10) for distant databases

# ---- Mobile app (see docs/mobile/MOBILE_ENVIRONMENT_VARIABLES.md) ----------------------------
APPLE_TEAM_ID=""          # Universal Links file is served only when set
ANDROID_CERT_SHA256=""    # App Links file is served only when set (Play app signing SHA-256)
MOBILE_APP_ID=""          # defaults to in.theprivate.app
FCM_SERVICE_ACCOUNT=""    # base64 Firebase service-account JSON; push is "not configured" without it
