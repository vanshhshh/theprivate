# ---- Database ---------------------------------------------------------------------
# Local development uses an embedded PostgreSQL started by `npm run db:start`.
DATABASE_URL="postgresql://theprivate:theprivate@127.0.0.1:54329/theprivate"

# ---- Auth -------------------------------------------------------------------------
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---- Integrations (leave empty until credentials and approvals exist) ---------------
EMAIL_PROVIDER=""          # resend | postmark | ses
EMAIL_API_KEY=""
EMAIL_FROM=""
SMS_PROVIDER=""            # twilio | gupshup
SMS_API_KEY=""
WHATSAPP_PROVIDER=""
WHATSAPP_API_KEY=""
PAYMENTS_MODE="pre-payment" # pre-payment | razorpay | stripe  (no real transactions in pre-payment mode)
STORAGE_DRIVER="local"      # local | s3
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
SENTRY_DSN=""
LOG_LEVEL="info"
